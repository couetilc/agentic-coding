#!/bin/bash
# Auto-push every commit: committing IS publishing the branch. This is the only
# way work leaves the agent container, and it keeps session branches
# continuously backed up. The protected default branch is parameterized via
# $DEFAULT_BRANCH (the launcher injects it from config; fallback main).
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ -z "$branch" ]; then
	exit 0 # detached HEAD (rebase, bisect) — nothing to push
fi
if [ "$branch" = "${DEFAULT_BRANCH:-main}" ]; then
	echo "post-commit: skipping auto-push (direct pushes to ${DEFAULT_BRANCH:-main} are blocked by the protect-branch ruleset)"
	exit 0
fi

if git push -u origin "$branch"; then
	echo "post-commit: auto-pushed $branch to origin"
else
	echo "post-commit: auto-push failed (non-fatal). In the agent container this usually means GH_TOKEN is missing from .env."
fi
exit 0
